digraph classification {
    rankdir=TB
    splines=ortho
    nodesep=0.6
    ranksep=0.55
    node [fontname="Helvetica", fontsize=12, style=filled, fillcolor="white", color="#263238", penwidth=1.4]
    edge [fontname="Helvetica", fontsize=11, color="#263238", penwidth=1.3, arrowsize=0.8]

    LOAD  [shape=box, label="Load = f · n · P / pf", fillcolor="#F5F5F5"]
    Q1    [shape=diamond, label="Connection >= Load"]
    Q2    [shape=diamond, label="Transformer present"]
    SP_A  [shape=box, label="Spare = Load"]
    SP_B  [shape=box, label="Spare = Load − Connection"]
    Q3    [shape=diamond, label="Spare <= Threshold\n&\nGrid Capacity >= Spare"]
    Q4    [shape=diamond, label="Transformer present"]
    T1    [shape=box, label="TYPE 1", fillcolor="#E3F2FD"]
    T2    [shape=box, label="TYPE 2", fillcolor="#E3F2FD"]
    T3    [shape=box, label="TYPE 3", fillcolor="#E3F2FD"]
    T4    [shape=box, label="TYPE 4", fillcolor="#E3F2FD"]

    LOAD -> Q1
    Q1 -> T1   [xlabel="TRUE"]
    Q1 -> Q2   [xlabel="FALSE"]
    Q2 -> SP_A [xlabel="FALSE"]
    Q2 -> SP_B [xlabel="TRUE"]
    SP_A -> Q3
    SP_B -> Q3
    Q3 -> T2   [xlabel="TRUE"]
    Q3 -> Q4   [xlabel="FALSE"]
    Q4 -> T3   [xlabel="TRUE"]
    Q4 -> T4   [xlabel="FALSE"]
}
