digraph item {
    rankdir=LR
    splines=ortho
    nodesep=0.35
    ranksep=0.9
    node [shape=box, style=filled, fontname="Helvetica", fontsize=15, margin="0.14,0.09"]
    edge [fontname="Helvetica", fontsize=13]


    subgraph cluster_inputs {
        label="User Inputs"
        fontname="Helvetica Bold"
        fontsize=16
        fontcolor="#1565C0"
        color="#1565C0"
        style=rounded
        bgcolor="#E3F2FD"
    I1 [label="Number of chargers (n)", fillcolor="#BBDEFB", color="#1565C0"]
    I2 [label="Power per charger (P) [kW]", fillcolor="#BBDEFB", color="#1565C0"]
    I4 [label="Grid connection capacity (G) [kVA]", fillcolor="#BBDEFB", color="#1565C0"]
    I6 [label="Load Power Factor (pf)", fillcolor="#BBDEFB", color="#1565C0"]
    I7 [label="Max LV connection power [kVA]", fillcolor="#BBDEFB", color="#1565C0"]
    I8 [label="Available MV/LV transformer capacity [kVA]", fillcolor="#BBDEFB", color="#1565C0"]
    I10 [label="MV level (V_MV) [kV]", fillcolor="#BBDEFB", color="#1565C0"]
    I12 [label="Distance to MV access point [m]", fillcolor="#BBDEFB", color="#1565C0"]
    I14 [label="Transformer present on premises?", fillcolor="#BBDEFB", color="#1565C0"]
    I17 [label="Simultaneity factor (f)", fillcolor="#BBDEFB", color="#1565C0"]
    I1 -> I8 [style=invis]
    I2 -> I10 [style=invis]
    I4 -> I12 [style=invis]
    I6 -> I14 [style=invis]
    I7 -> I17 [style=invis]
    }

    subgraph cluster_pt {
        label="Project Type"
        fontname="Helvetica Bold"
        fontsize=16
        fontcolor="#2E7D32"
        color="#2E7D32"
        style=rounded
        bgcolor="#E8F5E9"
        PT [label="Project Type\nClassification\n(Type 1/2/3/4)", fillcolor="#A5D6A7", color="#2E7D32", fontname="Helvetica Bold", fontsize=14]
    }

    subgraph cluster_sizing {
        label="Sizing Calculations"
        fontname="Helvetica Bold"
        fontsize=16
        fontcolor="#E65100"
        color="#E65100"
        style=rounded
        bgcolor="#FFF8E1"
    S4 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="/Users/davide/Documents/uni/ev-charging-cost-estimator/paper/figures/icons/linear.png"/></TD></TR><TR><TD ALIGN="CENTER"><B>MV Cables</B></TD></TR><TR><TD ALIGN="CENTER">I = (S−G)/(√3·V_MV)</TD></TR></TABLE>>, shape=box, fillcolor="#FFE0B2", color="#E65100"]
    }

    subgraph cluster_cf {
        label="Cost Functions"
        fontname="Helvetica Bold"
        fontsize=16
        fontcolor="#4527A0"
        color="#4527A0"
        style=rounded
        bgcolor="#EDE7F6"
    CF6 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="/Users/davide/Documents/uni/ev-charging-cost-estimator/paper/figures/icons/exponential.png"/></TD></TR><TR><TD ALIGN="CENTER"><B>MV Cables Cost</B></TD></TR><TR><TD ALIGN="CENTER">I [A], dist → €</TD></TR></TABLE>>, shape=box, fillcolor="#FCE4EC", color="#880E4F"]
    CF14 [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="2"><TR><TD><IMG SRC="/Users/davide/Documents/uni/ev-charging-cost-estimator/paper/figures/icons/derived.png"/></TD></TR><TR><TD ALIGN="CENTER"><B>MV Connection Cost</B></TD></TR><TR><TD ALIGN="CENTER">MV cable cost, dist → €</TD></TR></TABLE>>, shape=box, fillcolor="#ECEFF1", color="#546E7A"]
    }

    EUR [label="€  MV connection cost", shape=box, fillcolor="#E8F5E9", color="#2E7D32", fontname="Helvetica Bold", fontsize=11]


    I1 -> PT [color="#546E7A"]
    I2 -> PT [color="#546E7A"]
    I4 -> PT [color="#546E7A"]
    I6 -> PT [color="#546E7A"]
    I7 -> PT [color="#546E7A"]
    I8 -> PT [color="#546E7A"]
    I14 -> PT [color="#546E7A"]
    I17 -> PT [color="#546E7A"]
    I1 -> S4 [color="#546E7A"]
    I2 -> S4 [color="#546E7A"]
    I4 -> S4 [color="#546E7A"]
    I6 -> S4 [color="#546E7A"]
    I10 -> S4 [color="#546E7A"]
    I12 -> S4 [color="#546E7A"]
    I17 -> S4 [color="#546E7A"]
    PT -> S4 [color="#2E7D32", style=dashed, penwidth=1.5]
    S4 -> CF6 [label="I [A]", color="#1565C0", fontcolor="#1565C0", penwidth=2]
    I12 -> CF6 [color="#546E7A", style=dashed]
    PT -> CF6 [color="#2E7D32", style=dashed, penwidth=1.5]
    CF6 -> CF14 [label="cost [€]", color="#880E4F", fontcolor="#880E4F", penwidth=2]
    PT -> CF14 [color="#2E7D32", style=dashed, penwidth=1.5]
    I12 -> CF14 [color="#546E7A", style=dashed]
    CF14 -> EUR [color="#2E7D32", penwidth=2]
}